#!/usr/bin/env ruby
# frozen_string_literal: true

require "fontist"

flavors = ARGV

def die(message)
  warn message
  warn "Aborting..."
  exit(1)
end

Fontist::Formula.update_formulas_repo

def taste_fonts(flavor)
  require "metanorma-taste"
  config = Metanorma::TasteRegister.get_config(flavor.to_sym)
  fonts = config&.base_override&.value_attributes&.fonts
  fonts&.split(";")&.map(&:strip)&.reject(&:empty?)
rescue Metanorma::TasteRegister::UnknownTasteError, LoadError
  nil
end

flavors.each do |flavor|
  flavor_name = (flavor == "jcgm") ? "bipm" : flavor
  gem_name = "metanorma-#{flavor_name}"
  begin
    require gem_name
  rescue LoadError
    # A taste has no gem of its own: install the fonts its config declares
    if (fonts = taste_fonts(flavor_name))
      puts "Processing fonts for taste '#{flavor_name}' (metanorma-taste)..."
      fonts.each do |font|
        Fontist::Font.install(font, confirmation: "yes")
        puts "- #{font}"
      end
      puts "Done."
      next
    end
    raise
  end

  # Determine the processor class based on the flavor
  processor_class = "Metanorma::#{flavor_name.capitalize}::Processor"

  processor = Object
    .const_get(processor_class)
    .new

  unless processor.respond_to?(:fonts_manifest)
    puts "#{gem_name} does not require any fonts. Skipping."
    exit(0)
  end

  puts "Processing fonts for #{gem_name}..."
  unless processor.respond_to?(:fonts_manifest)
    die "#{processor_class} does not respond to :fonts_manifest"
  end

  puts "Using #{processor_class} to retrieve fonts manifest."
  puts "Fonts manifest for #{gem_name} (processor.fonts_manifest):"
  puts "--------------------------------------------------"
  puts "#{processor.fonts_manifest.inspect}"
  puts "--------------------------------------------------"

  manifest = Fontist::Manifest.from_hash(processor.fonts_manifest)
  manifest = manifest.install(confirmation: "yes")

  puts "# #{gem_name} related fonts"
  puts manifest.to_yaml
rescue LoadError => e
  die "Could not load gem '#{gem_name}': #{e.message}"
rescue NameError => e
  die "Could not find class '#{processor_class}': #{e.message}"
rescue Fontist::Errors => e
  die "Fontist failed with: #{e.message}"
rescue StandardError => e
  die "Unknown error: #{e.message}"
end
